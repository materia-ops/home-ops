{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // 7.0.0 consolidated the general-purpose presets into default.json —
    // earlier tags nest UNPINNED self-references that break when upstream
    // restructures (issue #1381). App presets stay opt-in: extend only what
    // this repo uses: CNPG image pins, GrafanaDashboard CRs, Talos factory.
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    ":timezone(Australia/Melbourne)",
    // Org policy — LAST so it wins over the upstream :automergeBranch: forces
    // PR-based automerge. The org ruleset forbids direct pushes to the default
    // branch, so every automerge goes via a PR that Renovate auto-merges.
    "github>materia-ops/.github//renovate/default",
  ],
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge mise tools",
      matchManagers: [ "mise" ],
      matchUpdateTypes: [ "minor", "patch" ],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: [ "docker" ],
      matchUpdateTypes: [ "digest" ],
      matchPackageNames: [ "/home-operations/" ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge raidscope image (own semver releases via release-please)",
      matchDatasources: [ "docker" ],
      matchUpdateTypes: [ "digest", "minor", "patch" ],
      matchPackageNames: [ "/raidscope/" ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge wow-panel image (own semver releases via release-please)",
      matchDatasources: [ "docker" ],
      matchUpdateTypes: [ "digest", "minor", "patch" ],
      matchPackageNames: [ "/wow-panel/" ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "AzerothCore server image — never auto-merge; human PR merge is the realm promotion gate (materia-vault projects/wow-server/context: 01-architecture-and-decisions.md §2, 10-pin-manifest-spec.md §4)",
      matchDatasources: [ "docker" ],
      matchPackageNames: [ "/azerothcore-wotlk-playerbots/" ],
      automerge: false,
    },
    {
      description: "AzerothCore MySQL image — never auto-merge; rolling the DB statefulset drops the worldserver's connection and loses unsaved realm progress. Run realm maintenance first.",
      matchDatasources: [ "docker" ],
      matchPackageNames: [ "/library\\/mysql/" ],
      automerge: false,
      prBodyNotes: [
        "⚠️ **Realm maintenance required before merging.** This rolls the `azerothcore-db` statefulset under the live worldserver. First run `saveall` (or a full `server shutdown`) via the wow-panel admin page or SOAP, then merge; the worldserver reconnects/restarts on its own once MySQL is back.",
      ],
    },
    {
      description: "kopiur chart — never auto-merge; alpha project that ships breaking changes in minor releases, and the kubectl-kopiur plugin must move in lockstep with the operator",
      matchDatasources: [ "docker" ],
      matchPackageNames: [ "/charts\\/kopiur/" ],
      automerge: false,
      prBodyNotes: [
        "⚠️ **Read the kopiur release notes before merging** (breaking changes land in minor releases), then bump kubectl-kopiur in WSL to the same version.",
      ],
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: [ "docker" ],
      matchUpdateTypes: [ "minor", "patch" ],
      matchPackageNames: [ "/kube-prometheus-stack/" ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: [ "before 6am on Monday" ],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: [ "github-actions" ],
      matchUpdateTypes: [ "minor", "patch", "digest" ],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: [ "github-actions" ],
      matchPackageNames: [ "/^actions\\//", "/^renovatebot\\//" ],
      matchUpdateTypes: [ "minor", "patch", "digest" ],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      // After the github-actions rules so its ignoreTests/soak win for the
      // lint image: those rules match it too (the trusted-actions rule by its
      // overridden name, renovatebot/renovate, on the later passes).
      description: "Auto-merge the Renovate runner pin — workflow version and lint image in one grouped PR — daily after a 1-day soak, canaried on its PR (#1715): a broken runner cannot open the PR that fixes itself (#1681)",
      matchPackageNames: [ "ghcr.io/renovatebot/renovate", "renovatebot/renovate" ],
      matchUpdateTypes: [ "minor", "patch" ],
      groupName: "Renovate runner",
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 day",
      ignoreTests: false,
      schedule: [ "before 4am" ],
    },
    {
      description: "Look the renovate-lint container image up as the runner's GitHub release: a GHCR tag carries no release timestamp, so the soak above would hold it forever",
      matchManagers: [ "github-actions" ],
      matchPackageNames: [ "ghcr.io/renovatebot/renovate" ],
      overrideDatasource: "github-releases",
      overridePackageName: "renovatebot/renovate",
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: [ "custom.grafana-dashboards" ],
      matchUpdateTypes: [ "major" ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: [ "renovate-config" ],
      matchUpdateTypes: [ "minor", "patch" ],
      automerge: true,
      automergeType: "pr",
      ignoreTests: true,
    },
    // Version constraint rules
    {
      description: "Proton Mail Bridge - only track v-prefixed release tags (repo mixes schemes)",
      matchDatasources: [ "docker" ],
      matchPackageNames: [ "/videocurio\\/proton-mail-bridge/" ],
      allowedVersions: "/^v\\d/",
    },
    {
      description: "Hold MySQL at the 8.4 LTS line — AzerothCore does not support 9.x innovation releases",
      matchDatasources: [ "docker" ],
      matchPackageNames: [ "/library\\/mysql/" ],
      allowedVersions: "<9.0.0",
    },
    // Grouping rules
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: [ "docker" ],
      matchPackageNames: [ "/gha-runner-scale-set-controller/", "/gha-runner-scale-set/" ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: [ "docker" ],
      matchPackageNames: [ "/flux-operator/", "/flux-instance/" ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: [ "docker" ],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: [ "docker" ],
      matchPackageNames: [ "/rook-ceph/", "/rook-ceph-cluster/" ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Bump both flate pins (.mise/config.toml + image-pull.yaml) in one PR",
      groupName: "flate",
      matchDepNames: [ "github:home-operations/flate", "home-operations/flate" ],
      minimumGroupSize: 2,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: [ "siderolabs/talos" ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    // Labeling rules
    {
      matchUpdateTypes: [ "major" ],
      addLabels: [ "type/major" ],
    },
    {
      matchUpdateTypes: [ "minor" ],
      addLabels: [ "type/minor" ],
    },
    {
      matchUpdateTypes: [ "patch" ],
      addLabels: [ "type/patch" ],
    },
    {
      matchUpdateTypes: [ "digest" ],
      addLabels: [ "type/digest" ],
    },
  ],
  // Track the CI version pins that no standard manager covers: flate and
  // talosctl in image-pull.yaml (pinned to .mise/config.toml and the
  // cluster's Talos version respectively) and the renovate runner's own version.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [ ".github/workflows/image-pull.yaml" ],
      matchStrings: [ "github:home-operations/flate (?<currentValue>[0-9.]+)" ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "home-operations/flate",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: [ ".github/workflows/image-pull.yaml" ],
      matchStrings: [ "talosctl (?<currentValue>[0-9.]+)" ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "siderolabs/talos",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
    {
      customType: "regex",
      managerFilePatterns: [ ".github/workflows/renovate.yaml" ],
      matchStrings: [ "RUNNER_VERSION: '(?<currentValue>[0-9.]+)'" ],
      // github-releases, not docker: ghcr.io returns no release timestamps, so
      // minimumReleaseAge on the docker datasource would hold the pin forever.
      datasourceTemplate: "github-releases",
      depNameTemplate: "renovatebot/renovate",
    },
  ],
}
