---
# talos:node-ip=192.168.20.12
machine:
  install:
    diskSelector:
      model: Samsung SSD 980 1TB
  # Experiment: no C7s-C10 (124-890us exit latency) while comparing igc rx FIFO
  # overruns against c2. Revert by setting "0" and applying before removing the keys.
  sysfs:
    {% for cpu in range(12) %}
    {% for state in range(5, 9) %}
    devices.system.cpu.cpu{{ cpu }}.cpuidle.state{{ state }}.disable: "1"
    {% endfor %}
    {% endfor %}
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: matalos-c3
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ipmi
selector:
  match: link.driver == "e1000e"
---
apiVersion: v1alpha1
kind: LinkConfig
name: ipmi
up: false
addresses: []
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  net.ipv6.conf.eno1.disable_ipv6: "1"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: link.driver == "igc" && mac(link.permanent_addr) == "02:76:c6:01:2b:bd"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net1
selector:
  match: link.driver == "igc" && mac(link.permanent_addr) == "02:76:c6:01:2b:be"
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp3s0
rings:
  rx: 4096
  tx: 1024
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp4s0
rings:
  rx: 4096
  tx: 1024
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - net0
  - net1
bondMode: 802.3ad
lacpRate: fast
xmitHashPolicy: layer3+4
miimon: 100
updelay: 200
downdelay: 200
mtu: 9000
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
